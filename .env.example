# ── SugarCARE Consult — environment variables ──
# Copy to ".env" for local dev, or set these in the Railway project's Variables tab.

# REQUIRED — Anthropic API key used by POST /api/analyse to fill the worksheet.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=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

# OPTIONAL — Groq API key for POST /api/transcribe (Whisper audio → text).
# Only needed if doctors use the "Upload / Record audio" input. Paste-text works without it.
GROQ_API_KEY=

# OPTIONAL — access password gate. If set, the whole app sits behind a login screen
# and only this password unlocks it. Leave blank to DISABLE the gate (open access).
ACCESS_PASSWORD=

# OPTIONAL — port. Railway sets PORT automatically; defaults to 3000 locally.
PORT=3000

# FUTURE — persistence / RAG layer (not used yet; worksheet-first, save comes later).
# DATABASE_URL=
